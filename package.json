{
  "name": "bot-wa-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "docs:api": "node scripts/typedoc-docs.cjs --options packages/core/typedoc.json",
    "docs": "pnpm run docs:api && vitepress build docs && node scripts/copy-api-docs.cjs",
    "docs:site": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:serve": "vitepress serve docs",
    "docs:check": "node scripts/smoke/docs-check.mjs",
    "typecheck": "pnpm -r typecheck",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "test:scripts": "node --test scripts/smoke/semver.test.mjs scripts/smoke/readme-links.test.mjs scripts/smoke/docs-check.test.mjs scripts/smoke/latest-render.test.mjs",
    "bench:soak": "node --expose-gc scripts/soak/soak.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm --filter create-bot-wa run gen:versions",
    "release": "pnpm clean && pnpm build && changeset publish",
    "clean": "node scripts/clean-lib.mjs"
  },
  "devDependencies": {
    "@bot-wa/core": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "mermaid": "^11.17.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  }
}
