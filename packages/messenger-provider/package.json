{
  "name": "@bot-wa/messenger",
  "version": "0.1.0",
  "type": "module",
  "description": "Facebook Messenger transport for @bot-wa/core — Meta Graph Send API + webhooks, quick replies, templates, typing.",
  "main": "lib/index.js", "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "engines": { "node": ">=22" },
  "keywords": ["bot-wa", "messenger", "facebook", "provider", "transport"],
  "author": "Andres Aya", "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andresayac/bot-wa-baileys.git", "directory": "packages/messenger-provider" },
  "homepage": "https://github.com/andresayac/bot-wa-baileys/tree/main/packages/messenger-provider#readme",
  "bugs": { "url": "https://github.com/andresayac/bot-wa-baileys/issues" },
  "files": ["./lib/**/*"],
  "scripts": { "build": "tsc", "test": "vitest run", "prepublishOnly": "pnpm build", "typecheck": "tsc -p tsconfig.test.json" },
  "dependencies": { "@bot-wa/core": "workspace:*", "@bot-wa/graph-core": "workspace:*", "@bot-wa/http": "workspace:*", "pino": "^10.3.1" },
  "devDependencies": { "@types/node": "^26.1.1", "typescript": "^7.0.2", "vite": "^7.3.6", "vitest": "^4.1.10" },
  "publishConfig": { "access": "public" }
}
