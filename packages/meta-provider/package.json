{
  "name": "@bot-wa/meta",
  "version": "0.1.0",
  "type": "module",
  "description": "WhatsApp Cloud API (official Meta) transport for @bot-wa/core — webhook-based, no ban risk, native buttons/lists/templates.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": ["bot-wa", "whatsapp", "cloud-api", "meta", "provider", "transport", "webhook"],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/bot-wa-baileys.git",
    "directory": "packages/meta-provider"
  },
  "homepage": "https://github.com/andresayac/bot-wa-baileys/tree/main/packages/meta-provider#readme",
  "bugs": { "url": "https://github.com/andresayac/bot-wa-baileys/issues" },
  "files": ["./lib/**/*"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@bot-wa/core": "workspace:*",
    "@bot-wa/graph-core": "workspace:*",
    "@bot-wa/http": "workspace:*",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
