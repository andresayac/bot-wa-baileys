{
  "name": "@botmesh/moderation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Group moderation plugin for @botmesh/core — anti-spam windows, word/regex filters, invite-link filtering and warn/mute/kick/delete actions.",
  "main": "lib/index.js", "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "engines": { "node": ">=22" },
  "keywords": ["botmesh", "moderation", "anti-spam", "groups", "whatsapp", "telegram"],
  "author": "Andres Aya", "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andresayac/botmesh.git", "directory": "packages/moderation" },
  "homepage": "https://github.com/andresayac/botmesh/tree/main/packages/moderation#readme",
  "bugs": { "url": "https://github.com/andresayac/botmesh/issues" },
  "files": ["./lib/**/*"],
  "scripts": { "build": "tsc", "test": "vitest run", "prepublishOnly": "pnpm build", "typecheck": "tsc -p tsconfig.test.json" },
  "dependencies": { "@botmesh/core": "workspace:*" },
  "devDependencies": { "@types/node": "^26.1.1", "typescript": "^7.0.2", "vite": "^7.3.6", "vitest": "^4.1.10" },
  "publishConfig": { "access": "public" }
}
