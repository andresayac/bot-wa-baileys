{
  "name": "@botmesh/http",
  "version": "0.2.0-alpha.0",
  "type": "module",
  "description": "Safe outbound HTTP primitives for BotWA providers.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "botmesh",
    "http",
    "ssrf",
    "security"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/http"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "undici": "^8.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/andresayac/botmesh/tree/main/packages/http#readme",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  }
}
