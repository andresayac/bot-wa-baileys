  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andresayac/bot-wa-baileys.git", "directory": "packages/wa-gateway-kit" },
  "homepage": "https://github.com/andresayac/bot-wa-baileys/tree/main/packages/wa-gateway-kit#readme",
  "bugs": { "url": "https://github.com/andresayac/bot-wa-baileys/issues" },
  "files": ["./lib/**/*"],
  "scripts": { "build": "tsc", "test": "vitest run", "typecheck": "tsc -p tsconfig.test.json" },
  "dependencies": { "@bot-wa/core": "workspace:*", "@bot-wa/http": "workspace:*" },
