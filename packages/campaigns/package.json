{
  "name": "@botmesh/campaigns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Consent-aware campaign planning, durable send reservations and broadcast settling for BotWA.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "author": "Andres Aya",
  "license": "MIT",
  "dependencies": {
    "@botmesh/core": "workspace:*",
    "@botmesh/tenant-kv": "workspace:*"
  },
  "devDependencies": {
    "@botmesh/postgres-store": "workspace:*",
    "@botmesh/redis-store": "workspace:*",
    "@botmesh/sqlite-store": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "better-sqlite3": "^11.7.0",
    "pg": "^8.13.0",
    "redis": "^4.7.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
