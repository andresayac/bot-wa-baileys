  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andresayac/botmesh.git", "directory": "packages/evolution-provider" },
  "homepage": "https://github.com/andresayac/botmesh/tree/main/packages/evolution-provider#readme",
  "bugs": { "url": "https://github.com/andresayac/botmesh/issues" },
  "files": ["./lib/**/*"],
  "scripts": { "build": "tsc", "test": "vitest run", "typecheck": "tsc -p tsconfig.test.json" },
  "dependencies": { "@botmesh/core": "workspace:*", "@botmesh/http": "workspace:*", "@botmesh/wa-gateway-kit": "workspace:*", "pino": "^10.3.1" },
