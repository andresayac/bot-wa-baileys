{
  "name": "create-botmesh",
  "version": "0.2.0-alpha.0",
  "type": "module",
  "description": "Scaffold a new @botmesh bot project (npm create botmesh).",
  "main": "lib/index.js", "types": "lib/index.d.ts",
  "bin": { "create-botmesh": "lib/cli.js" },
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "engines": { "node": ">=22" },
  "keywords": ["botmesh", "cli", "scaffolder", "create"],
  "author": "Andres Aya", "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andresayac/botmesh.git", "directory": "packages/create-botmesh" },
  "homepage": "https://github.com/andresayac/botmesh/tree/main/packages/create-botmesh#readme",
  "bugs": { "url": "https://github.com/andresayac/botmesh/issues" },
  "files": ["./lib/**/*"],
  "scripts": { "build": "node scripts/gen-versions.mjs && tsc", "gen:versions": "node scripts/gen-versions.mjs", "test": "vitest run", "prepublishOnly": "pnpm build", "typecheck": "tsc -p tsconfig.test.json" },
  "devDependencies": { "@types/node": "^26.1.1", "typescript": "^7.0.2", "vite": "^7.3.6", "vitest": "^4.1.10" }
}
