{
  "name": "@bot-wa/ai",
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-provider AI autoresponder plugin (Anthropic / OpenAI / Ollama) for @bot-wa/core, with per-chat conversation memory and a ctx.tools.ai client.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "bot",
    "baileys",
    "whatsapp",
    "ai",
    "llm",
    "anthropic",
    "claude",
    "openai",
    "ollama",
    "chatbot",
    "plugin"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/bot-wa-baileys.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/andresayac/bot-wa-baileys/tree/main/packages/ai#readme",
  "bugs": {
    "url": "https://github.com/andresayac/bot-wa-baileys/issues"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@bot-wa/core": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@google/generative-ai": "^0.21.0",
    "openai": "^6.48.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@types/node": "^26.1.1",
    "openai": "^6.48.0",
    "typescript": "^7.0.2"
  }
}
