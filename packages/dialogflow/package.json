{
  "name": "@bot-wa/dialogflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dialogflow ES/CX context for @bot-wa/core — detectIntent over REST with a service-account JWT (no Google SDK) and intent-to-flow routing.",
  "main": "lib/index.js", "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "engines": { "node": ">=22" },
  "keywords": ["bot-wa", "dialogflow", "dialogflow-cx", "nlu", "intent"],
  "author": "Andres Aya", "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andresayac/bot-wa-baileys.git", "directory": "packages/dialogflow" },
  "homepage": "https://github.com/andresayac/bot-wa-baileys/tree/main/packages/dialogflow#readme",
  "bugs": { "url": "https://github.com/andresayac/bot-wa-baileys/issues" },
  "files": ["./lib/**/*"],
  "scripts": { "build": "tsc", "test": "vitest run", "prepublishOnly": "pnpm build", "typecheck": "tsc -p tsconfig.test.json" },
  "dependencies": { "@bot-wa/core": "workspace:*", "@bot-wa/http": "workspace:*" },
  "devDependencies": { "@types/node": "^26.1.1", "typescript": "^7.0.2", "vite": "^7.3.6", "vitest": "^4.1.10" },
  "publishConfig": { "access": "public" }
}
