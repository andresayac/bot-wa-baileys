{
  "name": "@botmesh/voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice plugin for @botmesh/core — speech-to-text for inbound voice notes and text-to-speech replies (OpenAI, Deepgram, ElevenLabs) over plain HTTPS.",
  "main": "lib/index.js", "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "engines": { "node": ">=22" },
  "keywords": ["botmesh", "voice", "stt", "tts", "whisper", "deepgram", "elevenlabs", "transcription"],
  "author": "Andres Aya", "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andresayac/botmesh.git", "directory": "packages/voice" },
  "homepage": "https://github.com/andresayac/botmesh/tree/main/packages/voice#readme",
  "bugs": { "url": "https://github.com/andresayac/botmesh/issues" },
  "files": ["./lib/**/*"],
  "scripts": { "build": "tsc", "test": "vitest run", "prepublishOnly": "pnpm build", "typecheck": "tsc -p tsconfig.test.json" },
  "dependencies": { "@botmesh/core": "workspace:*", "@botmesh/http": "workspace:*" },
  "devDependencies": { "@types/node": "^26.1.1", "typescript": "^7.0.2", "vite": "^7.3.6", "vitest": "^4.1.10" },
  "publishConfig": { "access": "public" }
}
