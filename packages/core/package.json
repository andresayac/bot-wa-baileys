{
  "type": "module",
  "name": "@bot-wa/core",
  "version": "2.0.0-alpha.2",
  "description": "Transport-agnostic WhatsApp/omnichannel bot engine — flows, hooks, plugins, conversations.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/testing/index.d.ts",
      "default": "./lib/testing/index.js"
    },
    "./testing/vitest": {
      "types": "./lib/testing/vitest/index.d.ts",
      "default": "./lib/testing/vitest/index.js"
    },
    "./dev": {
      "types": "./lib/dev/index.d.ts",
      "default": "./lib/dev/index.js"
    },
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    }
  },
  "bin": {
    "bot-wa": "lib/dev/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "pnpm run start",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/bot-wa-baileys.git",
    "directory": "packages/core"
  },
  "keywords": [
    "bot",
    "baileys",
    "whatsapp",
    "bot-whatsapp",
    "flow",
    "chatbot"
  ],
  "files": [
    "./lib/**/*"
  ],
  "dependencies": {
    "pino": "^10.3.1"
  },
  "peerDependencies": {
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "author": "Andres Aya",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andresayac/bot-wa-baileys/issues"
  },
  "homepage": "https://github.com/andresayac/bot-wa-baileys/tree/main/packages/core#readme",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
