{
  "type": "module",
  "name": "@bot-wa/bot-wa-baileys",
  "version": "2.0.0-alpha.1",
  "description": "A modern WhatsApp bot framework built on Baileys 7 — flows, hooks, plugins, sub-APIs.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/testing/index.d.ts",
      "default": "./lib/testing/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "pnpm run build && tsc -p examples/tsconfig.json && node examples/bot.js",
    "example": "pnpm run start",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/bot-wa-baileys.git"
  },
  "keywords": [
    "bot",
    "baileys",
    "whatsapp",
    "bot-whatsapp",
    "flow",
    "chatbot",
    "whatsapp"
  ],
  "files": [
    "./lib/**/*"
  ],
  "dependencies": {
    "@cacheable/node-cache": "^1.5.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "fluent-ffmpeg": "^2.1.3",
    "follow-redirects": "^1.16.0",
    "mime-types": "^3.0.2",
    "pino": "^10.3.1",
    "qr-image": "^3.2.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3"
  },
  "author": "Andres Aya",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andresayac/bot-wa-baileys/issues"
  },
  "homepage": "https://github.com/andresayac/bot-wa-baileys#readme",
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
