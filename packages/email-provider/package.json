{
  "name": "@bot-wa/email",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Email transport for @bot-wa/core — IMAP IDLE inbound + SMTP outbound, threading, loop and bounce protection.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "engines": { "node": ">=22" },
  "keywords": ["bot-wa", "email", "imap", "smtp", "provider", "transport"],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/andresayac/bot-wa-baileys.git", "directory": "packages/email-provider" },
  "homepage": "https://github.com/andresayac/bot-wa-baileys/tree/main/packages/email-provider#readme",
  "bugs": { "url": "https://github.com/andresayac/bot-wa-baileys/issues" },
  "files": ["./lib/**/*"],
  "scripts": { "build": "tsc", "test": "vitest run", "prepublishOnly": "pnpm build", "typecheck": "tsc -p tsconfig.test.json" },
  "dependencies": { "@bot-wa/core": "workspace:*", "@bot-wa/http": "workspace:*", "pino": "^10.3.1" },
  "peerDependencies": { "imapflow": "^1.0.0", "nodemailer": "^6.9.0 || ^7.0.0" },
  "peerDependenciesMeta": { "imapflow": { "optional": true }, "nodemailer": { "optional": true } },
  "devDependencies": { "@types/node": "^26.1.1", "typescript": "^7.0.2", "vite": "^7.3.6", "vitest": "^4.1.10" },
  "publishConfig": { "access": "public" }
}
