{
  "name": "@botmesh/gohighlevel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GoHighLevel (LeadConnector) transport for @botmesh/core — Conversations API + signed InboundMessage webhooks.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "botmesh",
    "gohighlevel",
    "highlevel",
    "leadconnector",
    "crm",
    "provider",
    "transport"
  ],
  "author": "Andres Aya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresayac/botmesh.git",
    "directory": "packages/gohighlevel-provider"
  },
  "homepage": "https://github.com/andresayac/botmesh/tree/main/packages/gohighlevel-provider#readme",
  "bugs": {
    "url": "https://github.com/andresayac/botmesh/issues"
  },
  "files": [
    "./lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@botmesh/core": "workspace:*",
    "@botmesh/http": "workspace:*",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
