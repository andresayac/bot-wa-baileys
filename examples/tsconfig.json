{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": ".",
        "strict": false,
        "strictNullChecks": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "declaration": false,
        "types": ["node"]
    },
    "include": ["bot.ts"],
    "exclude": ["../node_modules"]
}