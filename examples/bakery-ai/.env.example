# Bakery AI assistant — copy to .env (git-ignored) and fill in.
# Never commit .env: it holds credentials. Variables already set in the
# environment win over this file.

# --- AI model (any @bot-wa/ai provider or preset) ---------------------------
# ollama | anthropic | openai | gemini | deepseek | qwen | glm | kimi | groq | openrouter | mistral | grok | together
AI_PROVIDER=ollama
# Needs a model with tool calling. Ollama default: llama3.1
AI_MODEL=llama3.1
OLLAMA_URL=http://127.0.0.1:11434
# Other providers: endpoint override and API key (or the SDK's own variable,
# e.g. ANTHROPIC_API_KEY, OPENAI_API_KEY, GROQ_API_KEY).
# AI_BASE_URL=
# AI_API_KEY=
# AI_TIMEOUT_MS=120000
# Long-term per-customer memory (one extra small model call per reply): on | off
# AI_MEMORY=on
# AI_MEMORY_MAX_FACTS=20
# AI_MEMORY_TTL=30d
# Anthropic thinking: auto | adaptive | off | <budget tokens, e.g. 2048>
# AI_THINKING=auto
# Reasoning effort: low | medium | high | xhigh | max
# AI_EFFORT=low
# Output-token cap per model call (thinking included)
# AI_MAX_TOKENS=4096
# AI_MAX_STEPS=5
# AI_CONTEXT_MESSAGES=20

# --- Who may talk to the bot ------------------------------------------------
# Comma-separated ids exactly as the channel reports them. Empty = everybody.
#   Baileys: 15551234567@s.whatsapp.net
#   Twilio:  whatsapp:+15551234567   (or a BSUID such as whatsapp:US.1234567890123456)
ALLOWED_USERS=
# all | mentions | commands (groups: only /commands, no AI)
GROUP_MODE=commands
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Baileys (pnpm start:baileys) ----------------------------------------
WA_SESSION=bakery
WA_SESSIONS_DIR=sessions
# Log in with a pairing code instead of the QR (digits, international format):
# WA_PAIRING_PHONE=15551234567

# --- Twilio (pnpm start:twilio) ------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp sandbox sender; use your own WhatsApp sender in production.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SMS_FROM=+15551234567
# Public https URL that reaches this server (e.g. your cloudflared tunnel).
PUBLIC_URL=
# WEBHOOK_PATH=/twilio/webhook
HOST=127.0.0.1
PORT=3000
